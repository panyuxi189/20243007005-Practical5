<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/municipalityRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_default_background">

    <TextView
        android:id="@+id/tvMunicipalityName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="Municipality"
        android:textColor="@color/color_text_light"
        android:textSize="24sp"
        android:textStyle="bold"
        android:background="@color/municipality_beijing" />

    <ImageView
        android:id="@+id/ivMunicipality"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:scaleType="centerCrop"
        android:src="@drawable/beijing"
        android:contentDescription="Municipality image" />

    <ScrollView
        android:id="@+id/scrollInformation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tvInformation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="Municipality information will appear here."
            android:textColor="@color/municipality_beijing"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />

    </ScrollView>

    <Button
        android:id="@+id/btnVisitSite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:text="Visit site"
        android:textColor="@color/color_text_light"
        android:backgroundTint="@color/municipality_beijing" />

</LinearLayout>