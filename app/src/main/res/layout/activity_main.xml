<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/color_default_background">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Municipalities in China"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_dark"
        android:gravity="center"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="20dp" />

    <ImageView
        android:id="@+id/ivMunicipalities"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:src="@drawable/chinese_municipalities"
        android:scaleType="centerCrop"
        android:contentDescription="Chinese municipalities"
        android:layout_marginBottom="28dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="I want to know about:"
        android:textSize="18sp"
        android:textColor="@color/color_text_dark"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etMunicipality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Beijing, Shanghai, Tianjin or Chongqing"
        android:inputType="textCapWords"
        android:singleLine="true"
        android:imeOptions="actionGo"
        android:textSize="17sp"
        android:padding="12dp" />

</LinearLayout>